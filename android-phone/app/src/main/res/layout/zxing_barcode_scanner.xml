<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the zxing-android-embedded default capture layout so the enrollment
  scanner uses our QrFinderView (square finder, corner brackets, no laser line).
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.journeyapps.barcodescanner.BarcodeView
        android:id="@+id/zxing_barcode_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <org.pushgate.phone.QrFinderView
        android:id="@+id/zxing_viewfinder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/zxing_status_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:paddingHorizontal="20dp"
        android:paddingVertical="10dp"
        android:text="Point the camera at the PushGate enrollment QR"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp" />
</merge>
