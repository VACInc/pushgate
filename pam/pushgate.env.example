PUSHGATE_SERVER=http://127.0.0.1:8000
PUSHGATE_CLIENT_ID=replace-me
PUSHGATE_CLIENT_SECRET=replace-me
PUSHGATE_APPROVER_USERNAME=
PUSHGATE_SYSTEM_NAME=
PUSHGATE_CACHE_DIR=/etc/pushgate/failmode.d
PUSHGATE_TIMEOUT=70
PUSHGATE_CACHE_MAX_AGE=86400
# Accounts that never pass on an outage (no fail-open cache, no offline code),
# separated by commas, semicolons or spaces. "export NAME=value" lines also work.
PUSHGATE_FAIL_CLOSED_USERS=
# Accept only server answers MACed with this integration's secret (requires a
# server that signs integration responses). Recommended once the server is
# upgraded: a TLS-level impersonator can then no longer answer "approved".
PUSHGATE_REQUIRE_SIGNED_RESPONSES=false
